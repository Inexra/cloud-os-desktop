#!/bin/sh
set -eu

# Give the live session a recognizable FeviOS identity.
printf '%s\n' 'FeviOS Live Session' > /etc/issue
printf '%s\n' 'FeviOS Live Session' > /etc/issue.net

# Set low-overhead XFCE compositor defaults for newly created users.
install -d -m 0755 /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml
cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="use_compositing" type="bool" value="true"/>
    <property name="vblank_mode" type="string" value="auto"/>
    <property name="show_frame_shadow" type="bool" value="false"/>
    <property name="show_popup_shadow" type="bool" value="false"/>
  </property>
</channel>
EOF

# Give Plank a modest, animated icon zoom without adding a second compositor.
install -d -m 0755 /usr/local/bin
cat > /usr/local/bin/fevios-dock <<'EOF'
#!/bin/sh
set -eu
if command -v dconf >/dev/null 2>&1; then
  dconf load /net/launchpad/plank/docks/dock1/ <<'CONF'
[/]
alignment='center'
icon-size=44
hide-mode='intelligent'
items-alignment='center'
position='bottom'
zoom-enabled=true
zoom-percent=135
CONF
fi
exec plank
EOF
chmod 0755 /usr/local/bin/fevios-dock

# Start Plank automatically for the live user and future users.
install -d -m 0755 /etc/skel/.config/autostart
cat > /etc/skel/.config/autostart/plank.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=FeviOS Dock
Comment=FeviOS application dock
Exec=/usr/local/bin/fevios-dock
OnlyShowIn=XFCE;
X-GNOME-Autostart-enabled=true
EOF

# Set a restrained dark theme and readable icon theme for new users.
install -d -m 0755 /etc/skel/.config/gtk-3.0
cat > /etc/skel/.config/gtk-3.0/settings.ini <<'EOF'
[Settings]
gtk-application-prefer-dark-theme=1
gtk-theme-name=Adwaita-dark
gtk-icon-theme-name=Papirus
gtk-font-name=Noto Sans 10
EOF

# Keep the live image responsive on machines with 4 GB RAM.
install -d -m 0755 /etc/default
if [ -f /etc/default/zramswap ]; then
  sed -i 's/^#*ALGO=.*/ALGO=zstd/' /etc/default/zramswap || true
  sed -i 's/^#*PERCENT=.*/PERCENT=50/' /etc/default/zramswap || true
fi

exit 0
